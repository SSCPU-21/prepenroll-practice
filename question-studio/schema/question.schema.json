{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepenroll AI Physics Question Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "curriculum",
    "level",
    "syllabus_version",
    "topic",
    "subtopic",
    "question_type",
    "difficulty",
    "stem",
    "answer",
    "worked_solution",
    "mark_scheme",
    "source_type",
    "review_status",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PQIA-[A-Z0-9-]{6,}$"
    },
    "curriculum": {
      "const": "IB Physics"
    },
    "level": {
      "enum": [
        "HL",
        "SL"
      ]
    },
    "syllabus_version": {
      "type": "string",
      "minLength": 4
    },
    "topic": {
      "type": "string",
      "pattern": "^[A-E]$"
    },
    "subtopic": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "enum": [
        "multiple_choice",
        "short_answer",
        "structured",
        "calculation"
      ]
    },
    "difficulty": {
      "enum": [
        "basic",
        "standard",
        "challenging"
      ]
    },
    "stem": {
      "type": "string",
      "minLength": 15
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "worked_solution": {
      "type": "string",
      "minLength": 10
    },
    "mark_scheme": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "marks"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "marks": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "total_marks": {
      "type": "integer",
      "minimum": 1
    },
    "source_type": {
      "enum": [
        "original_ai",
        "licensed_source",
        "teacher_authored"
      ]
    },
    "source_reference": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "generated",
        "validation_pending",
        "needs_review",
        "needs_fix",
        "approved",
        "rejected",
        "export_verified",
        "published"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approved_revision_hash": {
      "type": "string",
      "description": "Backend-generated immutable canonical content hash; required for export after approval"
    },
    "notes": {
      "type": "string"
    }
  }
}
